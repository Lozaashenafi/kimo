{
  "name": "@kimo-emoji/react",
  "version": "1.1.3",
  "description": "Production-ready React components, context providers, and tree-shakeable SVG emojis.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-dom --external @kimo-emoji/core"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@kimo-emoji/core": "workspace:*"
  },
  "keywords": [
    "react",
    "emoji",
    "svg",
    "icons",
    "components",
    "tree-shaking",
    "accessible"
  ],
  "author": "Kimo Emoji Open Source",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
