{
  "name": "@kimo-emoji/react",
  "version": "1.0.0",
  "description": "Production-ready React components, context providers, and tree-shakeable SVG emojis.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@kimo-emoji/core": "workspace:*"
  },
  "keywords": [
    "react",
    "emoji",
    "svg",
    "icons",
    "components",
    "tree-shaking",
    "accessible"
  ],
  "author": "Kimo Emoji Open Source",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
